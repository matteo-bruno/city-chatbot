# ---------------------------------------------------------------------------
# Provider and model
# ---------------------------------------------------------------------------
# Which API to talk to: gemini | anthropic
CITYCHAT_PROVIDER=gemini

# Which model. Leave EMPTY to use the provider's own default
# (gemini -> gemini-3.8-flash, anthropic -> claude-opus-5).
# Confirm the exact id your key can use with:
#   python scripts/check_provider.py --list-models
CITYCHAT_MODEL=

CITYCHAT_MAX_TOKENS=4096
# How many rounds of tool calls one answer may use before it must conclude.
CITYCHAT_MAX_TOOL_ROUNDS=8

# ---------------------------------------------------------------------------
# Gemini credentials and options (used when CITYCHAT_PROVIDER=gemini)
# ---------------------------------------------------------------------------
# Get one at https://aistudio.google.com/apikey . GOOGLE_API_KEY also works.
GEMINI_API_KEY=
# Override only for a proxy or a regional endpoint.
CITYCHAT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Optional. Leave empty for the model's default sampling.
CITYCHAT_TEMPERATURE=
# Optional thinking budget in tokens, on models that support it. 0 disables
# thinking for the fastest, cheapest answers; empty leaves the model's default.
CITYCHAT_THINKING_BUDGET=

# ---------------------------------------------------------------------------
# Claude credentials and options (used when CITYCHAT_PROVIDER=anthropic)
# ---------------------------------------------------------------------------
# Model ids are complete as written - never add a date suffix.
#   claude-opus-5     ($5/$25 per MTok)  default, best judgement
#   claude-sonnet-5   ($2/$10)           the sensible cost saving
#   claude-haiku-4-5  ($1/$5)            cheapest, weaker on methodology talk
ANTHROPIC_API_KEY=

# low | medium | high | xhigh | max. Leave EMPTY to use the model's default.
# Not accepted at all by Haiku 4.5; the provider drops it automatically if the
# model rejects it, so a model swap needs no other change.
CITYCHAT_EFFORT=medium

# Server-side fallback if a safety classifier declines a turn. Only meaningful
# on models that can return stop_reason "refusal" (Opus 5, Fable 5.x); set 0
# for anything else, or for a gateway that rejects beta flags.
CITYCHAT_REFUSAL_FALLBACK=1

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
CITYCHAT_DATA_DIR=data
CITYCHAT_KNOWLEDGE_DIR=knowledge
# Which prepared city to serve. Empty = the only one in data/cities.
CITYCHAT_CITY=milan

# ---------------------------------------------------------------------------
# Optional: live geocoding, so any address resolves and not just the gazetteer
# ---------------------------------------------------------------------------
# none | nominatim
CITYCHAT_GEOCODER=none
CITYCHAT_NOMINATIM_URL=https://nominatim.openstreetmap.org
# The public OSM endpoint requires a descriptive user agent and rate-limits to
# one request per second. Self-host Nominatim for anything beyond testing.
CITYCHAT_GEOCODER_USER_AGENT="city-chatbot/0.1 (you@example.org)"
CITYCHAT_GEOCODER_EMAIL=

# ---------------------------------------------------------------------------
# Optional: online search, for context the dataset and papers cannot supply
# ---------------------------------------------------------------------------
CITYCHAT_WEB_SEARCH=0
CITYCHAT_WEB_SEARCH_MAX_USES=4
# Comma-separated allowlist, e.g. nature.com,whatif.sonycsl.it. Empty = no limit.
CITYCHAT_WEB_SEARCH_DOMAINS=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Comma-separated CORS origins. Narrow this to your site in production.
CITYCHAT_ALLOW_ORIGINS="*"
# Only used by the optional `session_id` mode; history is client-side otherwise.
CITYCHAT_MAX_SESSIONS=200
CITYCHAT_MAX_HISTORY_MESSAGES=40
