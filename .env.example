# ---------------------------------------------------------------------------
# Claude API
# ---------------------------------------------------------------------------
# The only required setting. The SDK also picks up an `ant auth login` profile,
# so leave it empty if you use one.
ANTHROPIC_API_KEY=

# Model and reasoning effort. Opus 5 is the default; `claude-sonnet-5` is
# cheaper and fine for this workload if you want to trade a little quality.
CITYCHAT_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Raise it if answers feel shallow.
CITYCHAT_EFFORT=medium
CITYCHAT_MAX_TOKENS=4096
# How many rounds of tool calls one answer may use before it must conclude.
CITYCHAT_MAX_TOOL_ROUNDS=8
# Server-side fallback if a safety classifier declines a turn. Set to 0 if your
# account or gateway rejects the beta flag.
CITYCHAT_REFUSAL_FALLBACK=1

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
CITYCHAT_DATA_DIR=data
CITYCHAT_KNOWLEDGE_DIR=knowledge
# Which prepared city to serve. Empty = the only one in data/cities.
CITYCHAT_CITY=milan

# ---------------------------------------------------------------------------
# Optional: live geocoding, so any address resolves and not just the gazetteer
# ---------------------------------------------------------------------------
# none | nominatim
CITYCHAT_GEOCODER=none
CITYCHAT_NOMINATIM_URL=https://nominatim.openstreetmap.org
# The public OSM endpoint requires a descriptive user agent and rate-limits to
# one request per second. Self-host Nominatim for anything beyond testing.
CITYCHAT_GEOCODER_USER_AGENT=city-chatbot/0.1 (you@example.org)
CITYCHAT_GEOCODER_EMAIL=

# ---------------------------------------------------------------------------
# Optional: online search, for context the dataset and papers cannot supply
# ---------------------------------------------------------------------------
CITYCHAT_WEB_SEARCH=0
CITYCHAT_WEB_SEARCH_MAX_USES=4
# Comma-separated allowlist, e.g. nature.com,whatif.sonycsl.it. Empty = no limit.
CITYCHAT_WEB_SEARCH_DOMAINS=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Comma-separated CORS origins. Narrow this to your site in production.
CITYCHAT_ALLOW_ORIGINS=*
# Only used by the optional `session_id` mode; history is client-side otherwise.
CITYCHAT_MAX_SESSIONS=200
CITYCHAT_MAX_HISTORY_MESSAGES=40
